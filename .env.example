# Copy to .env or export from your secret manager. Never commit real values.
SKILLRL_ROOT=/path/to/skillRL
SKILLRL_CONDA_ROOT=/path/to/anaconda3
SKILLRL_MODEL_ROOT=/path/to/skillRL/models
SKILLRL_SLIME_PYTHON=/path/to/anaconda3/envs/slime/bin/python
SKILLRL_RELAX_PYTHON=/path/to/anaconda3/envs/relax/bin/python

# Student endpoint (local SGLang serving; any non-empty key works locally).
OPENAI_API_KEY=sk-local-anything
OPENAI_API_BASE=http://127.0.0.1:30000/v1

# Required by RL launchers; runs without W&B curves are refused by design.
WANDB_API_KEY=

# Teacher endpoint for SFT data collection (Phase 2) and the optional
# LLM-judge paths. "MAAS" is a historical variable name — any
# OpenAI-compatible provider works: set MAAS_API_BASE to its /v1 URL,
# MAAS_API_KEY to its key, and pick the teacher model via TEACHER_MODEL.
MAAS_API_KEY=
MAAS_API_BASE=

# Optional: higher-quota web_fetch inside benchmark tasks.
JINA_API_KEY=

# Set only if your network needs a Hugging Face mirror / egress proxy.
HF_ENDPOINT=https://hf-mirror.com
NO_PROXY=127.0.0.1,localhost,0.0.0.0
DOCKER_HOST=unix:///tmp/local-docker-overlay2.sock
